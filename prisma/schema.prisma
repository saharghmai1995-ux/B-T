// NeoBet Quant Pro — unified football + tennis commercial SaaS
// SQLite (local) — migratable to PostgreSQL/Supabase.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// One row per fixture/event (football match or tennis match).
model Match {
  id          String      @id @default(cuid())
  sport       String // "football" | "tennis"
  league      String // English display name, e.g. "English Premier League"
  leagueCode  String // ESPN code, e.g. "eng.1" | "wta"
  espnEventId String @unique
  homeName    String
  awayName    String
  homeLogo    String? // official ESPN logo / flag URL (used on signal cards + posters)
  awayLogo    String? // official ESPN logo / flag URL
  homeRank    Int? // tennis: player A ranking
  awayRank    Int? // tennis: player B ranking
  startTime   DateTime
  status      String // "pre" | "in" | "post"
  homeScore   Int?
  awayScore   Int?
  detail      String? // FT note / set score string
  surface     String? // tennis: Hard | Clay | Grass
  round       String?
  venue       String?
  source      String @default("ESPN")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  odds        OddsQuote[]
  signals     Signal[]

  @@index([sport, status, startTime])
  @@index([leagueCode])
}

// Every priced selection stored with its honest provenance.
model OddsQuote {
  id         String   @id @default(cuid())
  match      Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId    String
  bookmaker  String // "ESPN_DK_REF" | "1XBET_EST" | "1XBET_LIVE" | "BETFORWARD_EST"
  marketKey  String
  selection  String
  price      Float
  trueProb   Float // market-consensus probability the price is derived from
  source     String // "LIVE_REF" | "ESTIMATE"
  capturedAt DateTime @default(now())

  @@unique([matchId, bookmaker, marketKey, selection])
  @@index([matchId])
}

// A tradable recommendation issued by one of the 3 production lines
// (or the v3.1 Push-Shield superagent line).
model Signal {
  id          String    @id @default(cuid())
  match       Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId     String
  sport       String
  line        String // "SINGLE_EV" | "ACCA2" | "ARB" | "SHIELD"
  marketKey   String
  marketLabel String
  selection   String
  modelProb   Float
  trueProb    Float
  price       Float
  evPct       Float
  stake       Float
  stakeMode   String // "FLAT_100" | "KELLY_025"
  legs        String? // JSON: acca legs [{label, price, prob}]
  arbBooks    String? // JSON: [{book, selection, price}]
  shaHash     String    @unique
  status      String    @default("OPEN") // OPEN | WON | LOST | VOID
  netProfit   Float?
  settledAt   DateTime?
  dayKey      String // Tehran-locale YYYY-MM-DD — free-signal accounting
  createdAt   DateTime  @default(now())
  // v3.1 SuperAgent ensemble metadata (Push-Shield Hit-Rate Engine)
  tier         String? // "TIER_S" | "TIER_A" | "TIER_B"
  shieldType   String? // "DIRECT_WIN" | "FULL_PUSH_SHIELD" | "HALF_PUSH_SHIELD" | "DOUBLE_OUTCOME_SHIELD"
  noLossProb   Float?  // winProb + pushProb at lock time (blended + calibrated)
  consensusPct Float?  // agent consensus 0..100 (quant vs coach vs sharp)
  sharpSource  String? // "ESPN_CORE_PUBLIC" | "THE_ODDS_API" | "ODDSPAPI" when prior was available
  sharpAlert   Boolean? // sharp divergence > 16pp at lock time

  @@index([status, sport])
  @@index([line])
  @@index([dayKey])
  @@index([tier])
}

// Key-value store for API keys, tier demo switch, telegram config.
model Setting {
  key   String @id
  value String
}

// Outbox/audit log for telegram poster renders and sends.
model PosterLog {
  id        String   @id @default(cuid())
  kind      String // SIGNAL | WIN | LOSS | TEASER
  signalId  String?
  title     String
  sent      Boolean  @default(false)
  transport String   @default("preview") // preview | sendPhoto
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Singleton sync state for the ingest pipeline.
model IngestState {
  id          String   @id @default("singleton")
  lastRun     DateTime @default(now())
  lastSummary String
}

// Shadow ledger: supervisor vetoes that never touched the bank.
// v2.0: every veto carries the REAL fixture context + the REAL final score so
// the tracker can prove whether the veto actually saved the stake.
model ShadowVeto {
  id         String    @id @default(cuid())
  signalRef  String
  reason     String
  category   String
  sport      String? // "football" | "tennis"
  league     String?
  repMatch   String? // v2.7: representative fixture display name "Home vs Away"
  marketLabel String? // official English market name at veto time
  selection  String?
  price      Float?
  modelProb  Float?
  ftScore    String? // REAL final score (e.g. "2-1") once the fixture finished
  savedUnits Float? // positive => veto prevented a loss; negative => missed win
  verdict    String? // "SAVED_LOSS" | "MISSED_WIN" | "PENDING" | "UNKNOWN"
  decidedAt  DateTime? // when the fixture finished and the verdict was computed
  startTime  DateTime? // v2.7: REAL fixture kickoff for the tracker table
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// Broadcast schedule manager for the Telegram studio (honest status only:
// "sent" is stamped exclusively by an actual confirmed send action).
model BroadcastSchedule {
  id        String    @id @default(cuid())
  slotTitle String // e.g. "رادار صبح"
  time      String // "HH:mm" Tehran local time
  channel   String    @default("PUBLIC") // "PUBLIC" | "VIP"
  kind      String    @default("SIGNAL") // SIGNAL | EDUCATION | NEWS | REPORT | RADAR
  enabled   Boolean   @default(true)
  sentAt    DateTime? // stamped ONLY by a real confirmed send action
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([time])
}
